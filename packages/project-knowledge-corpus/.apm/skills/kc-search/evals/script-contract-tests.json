  "cases": [
    {
      "id": "search-statements-and-transcript",
      "script": "scripts/search-corpus.py",
      "fixture": "evals/script-fixtures/ready",
      "covers": [
        "search"
      ],
      "command": [
        "{python}",
        "{script}",
        "search",
        "--corpus-root",
        "{fixture}/corpus",
        "--scope",
        "{fixture}/scope.json",
        "--top-k",
        "10",
        "--query",
        "наставника"
      ],
      "expect": {
        "stdout_contains": [
          "Стажёру назначают наставника.",
          "занятие.расшифровано",
          "unassessed",
          "configured_sources_only"
        ]
      }
    },
    {
      "id": "evaluate-real-ranks",
      "script": "scripts/search-corpus.py",
      "fixture": "evals/script-fixtures/ready",
      "covers": [
        "evaluate"
      ],
      "command": [
        "{python}",
        "{script}",
        "evaluate",
        "--corpus-root",
        "{fixture}/corpus",
        "--scope",
        "{fixture}/scope.json",
        "--top-k",
        "10",
        "--suite",
        "{fixture}/suite.json"
      ],
      "expect": {
        "stdout_contains": [
          "\"recall_at_k\": 1.0",
          "\"answer_quality_measured\": false",
          "expanded-paraphrase"
        ]
      }
    },
    {
      "id": "empty-query-rejected",
      "script": "scripts/search-corpus.py",
      "fixture": "evals/script-fixtures/ready",
      "covers": [
        "search"
      ],
      "command": [
        "{python}",
        "{script}",
        "search",
        "--corpus-root",
        "{fixture}/corpus",
        "--scope",
        "{fixture}/scope.json",
        "--top-k",
        "10",
        "--query",
        "***"
      ],
      "expect": {
        "exit_code": 1,
        "stderr_contains": [
          "Query must contain words"
        ]
      }
    },
