# Локальная политика подагентов. Не добавляйте рабочий файл в Git.
# Идентификатор модели берите только из нативного каталога активной оснастки.

# Это единственный источник рабочей политики. Короткий фрагмент в реально
# загружаемой инструкции оснастки только направляет агента сюда, не копируя
# проектные правила. Состояния подключения и исполнения различаются.
[policy_runtime]
schema_version = 2
launcher = "tools/run-execution-class"
target = "codex"
# direct_execution = ["микрозадача", "контракт и приёмка дороже ожидаемой пользы"]
# direct_execution_scope = "whole_parent_task"
# subtask_routing = "match_each_bounded_subtask"
# parent_comparison = "actual_current_session"
# unknown_parent_parameters = "comparison_unresolved"
# parent_change = "invalidate_comparison"
# assignment_basis = "historical_only"
# comparison_evidence_level = "client_execution"
# unavailable_route = "необязательную работу выполняет родитель; обязательную эскалировать владельцу"
# execution_failure = "результат не использовать; применить unavailable_route; повторять только после изменения среды или маршрута"
# unconfirmed_model = "результат можно принять только по result_acceptance, если задача не требует подтверждённой модели; иначе применить unavailable_route без повтора того же запуска"
# result_acceptance = "родитель сверяет результат с критериями и использует только принятый результат"
# execution_status = "not_checked" # not_checked, checked или blocked
# economy_status = "not_measured" # not_measured, measured или confirmed

[[policy_runtime.routes]]
# when = "ограниченный поиск по нескольким файлам"
# execution_class = "cheap_readonly_research"

# Единое предложение заполните до технической настройки.
# Запускатель не проверяет смысл этих полей. Сверьте их с итоговым ответом.
# [policy_design]
# task_coverage = "unknown"
# design_status = "provisional"
# implementation_status = "unchanged"
# verification_status = "pending"
# [[policy_design.tasks]]
# task = "сравнить варианты решения"
# acceptance = "альтернативы сравнены по заданным критериям"
# parent_basis = "historical_setup_observation"
# parent_basis_model = "unknown"
# parent_basis_effort = "unknown"
# parent_basis_evidence = "метаданные активной сессии на момент настройки либо явная неизвестность"
# parent_basis_observed_at = "unknown"
# delegation_reason = "польза относительно прямого выполнения и расходы всего маршрута"
# proposed_effort = "unknown"
# effort_reason = "достаточность для задачи пока не установлена"
# candidate_comparison = "почему кандидат предпочтительнее подходящих альтернатив"
# proposed_route = "execution_class:analysis"
# proposed_candidates = ["candidate-a", "candidate-b"]
# selection_status = "unresolved" # provisional, unresolved или excluded
# reason = "нужны сопоставимые проверки качества рекомендаций"
# current_route = "parent"
# retention_reason = "новый класс ещё не проверен"
# retention_effect = "новое предложение пока не исполняется"
# replacement_condition = "подтверждены исполнение и пригодность нового назначения"
# verification_status = "blocked"
# next_step = "получить свидетельство исполнения, затем сравнить кандидатов"
# Для parent и human список кандидатов пуст, причина относится к самой задаче.
# Если выбран один предварительный кандидат, укажите только его и основание.

[policy_review]
# Состояния: "configured" или "creation_declined".
# state = "configured"
# interval_days = 30
# Дата последней успешной проверки в формате YYYY-MM-DD.
# last_checked_at = "YYYY-MM-DD"

[adapters]
# Здесь записывается только адаптер каталога моделей оснастки. Он обязан
# отвечать каталогом на вызов <команда> list и пробой на вызов <команда> <модель>.
# Адаптер класса исполнения сюда не записывается: его место — поле adapter
# назначения класса. Если у оснастки нет адаптера каталога, оставьте раздел
# пустым и назовите ограничение, а не подставляйте файл другого назначения.
# alpha = ["path/to/catalog-adapter"]

# models = ["alpha:точный-идентификатор-из-каталога"]

[execution_classes.cheap_readonly_research]
# Контракт класса не зависит от оснастки и не содержит модель.
# writes = false
# result = "status, items, evidence, confidence, risk, open_questions, escalation_needed"
# stop = "неоднозначность, конфликтующие свидетельства, недостающий контекст или выход за границу"

[targets.alpha.execution_classes.cheap_readonly_research]
# Назначение класса для одной оснастки. Класс без назначения считается
# ненастроенным для неё, и задачу выполняет родитель.
# model = "точный-идентификатор-из-каталога"
# effort = "поддерживаемое-усилие"
# sandbox = "read-only"
# adapter = ["path/to/execution-class-adapter"]

# Для точного идентификатора `actual_model_prefix` не нужен. Если оснастка
# принимает псевдоним, укажите префикс фактического идентификатора, который
# разрешено считать соответствием. Не добавляйте в образец модели, лимиты или
# классы конкретного проекта.
