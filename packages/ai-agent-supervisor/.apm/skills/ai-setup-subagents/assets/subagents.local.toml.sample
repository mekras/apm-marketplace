# Локальная политика подагентов. Не добавляйте рабочий файл в Git.
# Идентификатор модели берите только из нативного каталога активной оснастки.

# Единое предложение заполните до технической настройки.
# Запускатель не проверяет смысл этих полей. Сверьте их с итоговым ответом.
# [policy_design]
# task_coverage = "unknown"
# design_status = "provisional"
# implementation_status = "unchanged"
# verification_status = "pending"
# [[policy_design.tasks]]
# task = "сравнить варианты решения"
# acceptance = "альтернативы сравнены по заданным критериям"
# parent_model = "unknown"
# parent_effort = "unknown"
# parent_evidence = "метаданные активной сессии либо явная неизвестность"
# delegation_reason = "польза относительно прямого выполнения и расходы всего маршрута"
# proposed_effort = "unknown"
# effort_reason = "достаточность для задачи пока не установлена"
# candidate_comparison = "почему кандидат предпочтительнее подходящих альтернатив"
# proposed_route = "execution_class:analysis"
# proposed_candidates = ["candidate-a", "candidate-b"]
# selection_status = "unresolved" # provisional, unresolved или excluded
# reason = "нужны сопоставимые проверки качества рекомендаций"
# current_route = "parent"
# retention_reason = "новый класс ещё не проверен"
# retention_effect = "новое предложение пока не исполняется"
# replacement_condition = "подтверждены исполнение и пригодность нового назначения"
# verification_status = "blocked"
# next_step = "получить свидетельство исполнения, затем сравнить кандидатов"
# Для parent и human список кандидатов пуст, причина относится к самой задаче.
# Если выбран один предварительный кандидат, укажите только его и основание.

[policy_review]
# Состояния: "configured" или "creation_declined".
# state = "configured"
# interval_days = 30
# Дата последней успешной проверки в формате YYYY-MM-DD.
# last_checked_at = "YYYY-MM-DD"

[adapters]
# alpha = ["path/to/model-check-adapter"]

# models = ["alpha:точный-идентификатор-из-каталога"]

[execution_classes.cheap_readonly_research]
# Контракт класса не зависит от оснастки и не содержит модель.
# writes = false
# result = "status, items, evidence, confidence, risk, open_questions, escalation_needed"
# stop = "неоднозначность, конфликтующие свидетельства, недостающий контекст или выход за границу"

[targets.alpha.execution_classes.cheap_readonly_research]
# model = "точный-идентификатор-из-каталога"
# effort = "поддерживаемое-усилие"
# sandbox = "read-only"
# adapter = ["path/to/execution-adapter"]

# Для точного идентификатора `actual_model_prefix` не нужен. Если оснастка
# принимает псевдоним, укажите префикс фактического идентификатора, который
# разрешено считать соответствием. Не добавляйте в образец модели, лимиты или
# классы конкретного проекта.
