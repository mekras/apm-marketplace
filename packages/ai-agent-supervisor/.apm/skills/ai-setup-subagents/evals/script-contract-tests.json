            "contains": "у всех кандидатов есть критические дефекты"
          }
        ]
      }
    },
    {
      "id": "report-only-one-eligible-candidate",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [c['eligibility'].update({'within_budget':False}) for c in d['candidates'] if c['id']=='candidate-b']; json.dump(d,open(p+'/one-eligible.json','w'))",
          "{fixture}"
        ]
