          {
            "path": "one-eligible-report.json",
            "json": true,
            "contains": "для сравнения нужны минимум два"
          }
        ]
      }
    },
    {
      "id": "report-critical-defect-refutation",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [(r.update({'accepted_without_revision':True,'critical_defect':False,'total_cost_units':1})) for r in d['runs'] if r['candidate_id']=='candidate-b' and not r['case_id'].startswith('holdout-')]; [(r.update({'critical_defect':True})) for r in d['runs'] if r['candidate_id']=='candidate-b' and r['case_id'].startswith('holdout-')]; json.dump(d,open(p+'/critical-refuted.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/critical-refuted.json",
        "--output",
        "{fixture}/critical-refuted-report.json"
      ],
      "expect": {
        "stdout_contains": ["refuted", "candidate-b"],
        "files": [
          {
            "path": "critical-refuted-report.json",
            "json": true,
            "contains": "дополнительный критический дефект"
          }
        ]
      }
    },
    {
      "id": "report-quality-refutation",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); hold=[r for r in d['runs'] if r['case_id'].startswith('holdout-')]; [(r.update({'accepted_without_revision':r['candidate_id']=='candidate-b','critical_defect':False})) for r in hold]; seeds={(r['candidate_id'],r['case_id']):r for r in hold}.values(); d['runs'] += [dict(r,repeat=n) for r in seeds for n in range(3,31)]; json.dump(d,open(p+'/quality-refuted.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/quality-refuted.json",
        "--output",
        "{fixture}/quality-refuted-report.json"
      ],
      "expect": {
        "stdout_contains": ["refuted"],
        "files": [
          {
            "path": "quality-refuted-report.json",
            "json": true,
            "contains": "нижняя граница отставания превысила"
          }
        ]
      }
    },
    {
      "id": "report-insufficient-quality-and-review-time",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); hold=[r for r in d['runs'] if r['case_id'].startswith('holdout-')]; [(r.update({'accepted_without_revision':True,'critical_defect':False,'review_seconds':10})) for r in hold if r['candidate_id']=='candidate-b']; a=[r for r in hold if r['candidate_id']=='candidate-a']; [(r.update({'review_seconds':20})) for r in a]; a[0]['accepted_without_revision']=False; json.dump(d,open(p+'/review-insufficient.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/review-insufficient.json",
        "--output",
        "{fixture}/review-insufficient-report.json"
