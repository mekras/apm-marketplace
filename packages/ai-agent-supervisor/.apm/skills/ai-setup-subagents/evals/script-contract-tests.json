      }
    },
    {
      "id": "report-excluded-by-deterministic-failure",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); d['candidates'][1]['eligibility']['repeated_deterministic_failure']=True; json.dump(d,open(p+'/deterministic-failure.json','w'))",
          "{fixture}"
        ]
      ],
      "command": ["{python}", "{script}", "--input", "{fixture}/deterministic-failure.json", "--output", "{fixture}/deterministic-failure-report.json"],
