        "{fixture}/complete.json"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_contains": ["вход и выход должны быть разными файлами"]
      }
    },
    {
      "id": "report-insufficient-holdout-volume",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
