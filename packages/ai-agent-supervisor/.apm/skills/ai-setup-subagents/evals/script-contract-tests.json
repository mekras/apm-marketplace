{
  "version": 2,
  "operations": [
    {
      "id": "assess-policy-connection",
      "script": "scripts/assess-subagent-policy-connection.py",
      "command_prefix": [],
      "inputs": ["subagents.local.toml", "worker-instructions.md"]
    },
    {
      "id": "migrate-subagent-policy",
      "script": "scripts/migrate-subagent-policy.py",
      "command_prefix": [],
      "inputs": ["subagents.local.toml", "worker-instructions.md"]
    },
    {
      "id": "evaluate-model-selection",
      "script": "scripts/evaluate-model-selection.py",
      "command_prefix": [],
      "inputs": []
    },
    {
      "id": "check-subagent-tools-drift-portable",
      "script": "scripts/check-subagent-tools-drift.py",
      "command_prefix": ["--profile", "portable"],
      "inputs": []
    }
  ],
  "cases": [
    {
      "id": "assess-connected-policy",
      "script": "scripts/assess-subagent-policy-connection.py",
      "fixture": "evals/script-fixtures/policy-connection",
      "covers": ["assess-policy-connection"],
      "command": [
        "{python}", "{script}", "--config", "{fixture}/subagents.local.toml",
        "--entrypoint", "codex={fixture}/worker-instructions.md", "--output", "{fixture}/report.json", "--json"
      ],
      "expect": {
        "stdout_contains": ["\"instruction_entrypoints\": \"referenced\"", "\"working_sessions\": \"not_observed\""],
        "files": [{"path": "report.json", "json": true}]
      }
    },
    {
      "id": "migrate-v1-policy-and-entrypoint",
      "script": "scripts/migrate-subagent-policy.py",
      "fixture": "evals/script-fixtures/policy-migration",
      "covers": ["migrate-subagent-policy"],
      "command": [
        "{python}", "{script}",
        "--config", "{fixture}/subagents.local.toml",
        "--entrypoint", "codex={fixture}/worker-instructions.md"
      ],
      "expect": {
        "stdout_contains": ["Политика подагентов мигрирована."],
        "files": [
          {"path": "subagents.local.toml", "contains": "schema_version = 2"},
          {"path": "subagents.local.toml", "contains": "parent_basis_model = \"historical assignment\""},
          {"path": "worker-instructions.md", "contains": "`direct_execution_scope = \"whole_parent_task\"` означает только"},
          {"path": "worker-instructions.md", "contains": "не отменяет отдельного"},
          {"path": "worker-instructions.md", "contains": "Это ограничение относится только к этому маршруту"},
          {"path": "worker-instructions.md", "contains": "Независимо от класса дочерний исполнитель"},
          {"path": "worker-instructions.md", "contains": "защищённые источники"},
          {"path": "worker-instructions.md", "contains": "Микрозадачи не"}
        ]
      }
    },
    {
      "id": "check-installed-portable-tools",
      "script": "scripts/check-subagent-tools-drift.py",
      "fixture": "evals/script-fixtures/tools-drift",
      "covers": ["check-subagent-tools-drift-portable"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import os,subprocess,sys; pathlib=__import__('pathlib'); installer=str(pathlib.Path(sys.argv[1]).with_name('install-subagent-tools')); root=pathlib.Path(sys.argv[2]); target='/' + root.drive.rstrip(':').lower() + root.as_posix()[2:] if os.name == 'nt' else str(root); git=__import__('shutil').which('git'); shell=str(pathlib.Path(git).parent.parent/'bin'/'bash.exe') if os.name == 'nt' and git else 'bash'; raise SystemExit(subprocess.run([shell,installer,target],check=False).returncode)",
          "{script}",
          "{fixture}/project"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--profile",
        "portable",
        "--project-root",
        "{fixture}/project"
      ],
      "expect": {
        "files": [
          {
            "path": "project/tools/check-subagent-models"
          }
        ]
      }
    },
    {
      "id": "evaluate-complete-model-matrix",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/complete.json",
        "--output",
        "{fixture}/report.json"
      ],
      "expect": {
        "stdout_contains": ["confirmed", "candidate-a"],
        "files": [
          {
            "path": "report.json",
            "json": true,
            "contains": "\"policy_action\": \"owner_decision_required\""
          }
        ]
      }
    },
    {
      "id": "reject-incomplete-model-matrix",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/invalid.json",
        "--output",
        "{fixture}/invalid-report.json"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_contains": ["contract_sha256"]
      }
    },
    {
      "id": "report-insufficient-without-full-cost",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [r.pop('total_cost_units',None) for r in d['runs']]; json.dump(d,open(p+'/without-total.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/without-total.json",
        "--output",
        "{fixture}/without-total-report.json"
      ],
      "expect": {
        "stdout_contains": ["insufficient_data"],
        "files": [
          {
            "path": "without-total-report.json",
            "json": true,
            "contains": "полная стоимость не задана"
          }
        ]
      }
    },
    {
      "id": "report-refuted-by-cost",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); d['settings']['refutation_savings_percent']=70; d['settings']['confirmation_savings_percent']=80; json.dump(d,open(p+'/cost-refuted.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/cost-refuted.json",
        "--output",
        "{fixture}/cost-refuted-report.json"
      ],
      "expect": {
        "stdout_contains": ["refuted"],
        "files": [
          {
            "path": "cost-refuted-report.json",
            "json": true,
            "contains": "экономия полной стоимости ниже порога опровержения"
          }
        ]
      }
    },
    {
      "id": "exclude-by-quality-interval",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [(r.update({'critical_defect':False})) for r in d['runs'] if r['candidate_id']=='candidate-b']; json.dump(d,open(p+'/quality-elimination.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/quality-elimination.json",
        "--output",
        "{fixture}/quality-elimination-report.json"
      ],
      "expect": {
        "stdout_contains": ["insufficient_data"],
        "files": [
          {
            "path": "quality-elimination-report.json",
            "json": true,
            "contains": "quality_interval"
          }
        ]
      }
    },
    {
      "id": "report-no-sequential-candidate",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [(r.update({'critical_defect':True})) for r in d['runs'] if r['candidate_id']=='candidate-a' and r['case_id']=='normal-1']; json.dump(d,open(p+'/no-candidate.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/no-candidate.json",
        "--output",
        "{fixture}/no-candidate-report.json"
      ],
      "expect": {
        "stdout_contains": ["insufficient_data"],
        "files": [
          {
            "path": "no-candidate-report.json",
            "json": true,
            "contains": "все кандидаты исключены"
          }
        ]
      }
    },
    {
      "id": "report-no-holdout-baseline",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [(r.update({'critical_defect':True})) for r in d['runs'] if r['case_id'].startswith('holdout-')]; json.dump(d,open(p+'/no-baseline.json','w'))",
          "{fixture}"
