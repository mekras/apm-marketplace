      "expect": {
        "stdout_contains": ["insufficient_data"],
        "files": [
          {
            "path": "quality-elimination-report.json",
            "json": true,
            "contains": "quality_interval"
          }
        ]
      }
    },
    {
      "id": "report-no-sequential-candidate",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [(r.update({'critical_defect':True})) for r in d['runs'] if r['candidate_id']=='candidate-a' and r['case_id']=='normal-1']; json.dump(d,open(p+'/no-candidate.json','w'))",
          "{fixture}"
        ]
