{
  "version": 2,
  "operations": [
    {
      "id": "evaluate-model-selection",
      "script": "scripts/evaluate-model-selection.py",
      "command_prefix": [],
      "inputs": []
    }
  ],
  "cases": [
    {
      "id": "evaluate-complete-model-matrix",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/complete.json",
        "--output",
        "{fixture}/report.json"
      ],
      "expect": {
        "stdout_contains": ["confirmed", "candidate-a"],
        "files": [
          {
            "path": "report.json",
            "json": true,
            "contains": "\"policy_action\": \"owner_decision_required\""
          }
        ]
      }
    },
    {
      "id": "reject-incomplete-model-matrix",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/invalid.json",
        "--output",
        "{fixture}/invalid-report.json"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_contains": ["contract_sha256"]
      }
    },
    {
      "id": "report-insufficient-without-full-cost",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [r.pop('total_cost_units',None) for r in d['runs']]; json.dump(d,open(p+'/without-total.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/without-total.json",
        "--output",
        "{fixture}/without-total-report.json"
      ],
      "expect": {
        "stdout_contains": ["insufficient_data"],
        "files": [
          {
            "path": "without-total-report.json",
            "json": true,
            "contains": "полная стоимость не задана"
          }
        ]
      }
    },
    {
      "id": "report-refuted-by-cost",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); d['settings']['refutation_savings_percent']=70; d['settings']['confirmation_savings_percent']=80; json.dump(d,open(p+'/cost-refuted.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/cost-refuted.json",
        "--output",
        "{fixture}/cost-refuted-report.json"
      ],
      "expect": {
        "stdout_contains": ["refuted"],
        "files": [
          {
            "path": "cost-refuted-report.json",
            "json": true,
            "contains": "экономия полной стоимости ниже порога опровержения"
          }
        ]
      }
    },
    {
      "id": "exclude-by-quality-interval",
      "script": "scripts/evaluate-model-selection.py",
      "fixture": "evals/script-fixtures/model-selection",
      "covers": ["evaluate-model-selection"],
      "prepare": [
        [
          "{python}",
          "-c",
          "import json,sys; p=sys.argv[1]; d=json.load(open(p+'/complete.json')); [(r.update({'critical_defect':False})) for r in d['runs'] if r['candidate_id']=='candidate-b']; json.dump(d,open(p+'/quality-elimination.json','w'))",
          "{fixture}"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "--input",
        "{fixture}/quality-elimination.json",
        "--output",
        "{fixture}/quality-elimination-report.json"
