#!/usr/bin/env python3
"""Запуск роли Codex: модель, усилие, режим доступа; задача приходит через stdin."""
from __future__ import annotations

import json, os, runpy, subprocess, sys, tempfile
from pathlib import Path


verify_model = runpy.run_path(
    str(Path(__file__).resolve().parents[1] / "lib/model_evidence.py")
)["verify_model"]

# Русские сообщения не должны падать на консоли с однобайтовой кодировкой.
for _stream in (sys.stdout, sys.stderr):
    _reconfigure = getattr(_stream, "reconfigure", None)
    if _reconfigure is not None:
        _reconfigure(encoding="utf-8", errors="replace")

if len(sys.argv) != 4:
    raise SystemExit("Использование: codex-role <модель> <усилие> <режим>")
model, effort, sandbox = sys.argv[1:]
with tempfile.TemporaryDirectory() as directory:
    final = Path(directory) / "final.txt"
    run = subprocess.run(["codex", "exec", "--json", "--color", "never", "--strict-config", "--skip-git-repo-check", "--sandbox", sandbox, "--model", model, "-c", f'model_reasoning_effort="{effort}"', "--output-last-message", str(final), "-"], input=sys.stdin.read(), text=True, encoding="utf-8", errors="replace", capture_output=True)
    raw_log = os.environ.get("CODEX_ROLE_LOG")
    if raw_log:
        Path(raw_log).write_text(run.stdout, encoding="utf-8")
    usage = None
    for line in run.stdout.splitlines():
        try:
            event = json.loads(line)
            if event.get("type") == "turn.completed": usage = event.get("usage")
        except json.JSONDecodeError: pass
    evidence = verify_model(
        {},
        Path(raw_log) if raw_log else Path(os.devnull),
        assigned_model=model,
        assigned_effort=effort,
    )
    print(json.dumps({
        "model": evidence["actual_model"],
        "model_evidence": evidence["model_evidence"],
        "effort": evidence["actual_effort"],
        "effort_evidence": evidence["effort_evidence"],
        "execution_evidence": evidence["execution_evidence"],
        "model_notice": (
            None
            if evidence["model_status"] == "confirmed"
            else "Фактическая модель не подтверждена"
        ),
        "usage": usage,
    }, ensure_ascii=False))
    if final.exists(): print(final.read_text(encoding="utf-8"), end="")
    if run.returncode: print(run.stderr, file=sys.stderr, end="")
    raise SystemExit(run.returncode)
