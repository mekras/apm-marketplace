#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  install-subagent-tools [project-root]

Copies portable subagent tools and their local configuration sample into
<project-root>/tools. Install adapters for the active harness separately.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="${1:-$(git rev-parse --show-toplevel)}"
manifest="$script_dir/subagent-tools.manifest"

install_profile() {
  local profile="$1"
  while IFS='|' read -r source destination mode profiles; do
  case "$source" in ''|\#*) continue ;; esac
  profiles="${profiles%$'\r'}"
  [[ ",$profiles," == *",$profile,"* ]] || continue
    source="$script_dir/$source"
    destination="$project_root/$destination"
    [[ -f "$source" ]] || { echo "Источник не найден: $source" >&2; exit 1; }
    mkdir -p "$(dirname -- "$destination")"
    install -m "0$mode" "$source" "$destination"
  done < "$manifest"
}

[[ -f "$manifest" ]] || { echo "Манифест не найден: $manifest" >&2; exit 1; }
install_profile portable

printf 'installed=%s\n' "$project_root/tools"
