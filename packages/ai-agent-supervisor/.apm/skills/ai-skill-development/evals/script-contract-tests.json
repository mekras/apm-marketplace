      "prepare": [["{python}", "{script}", "--input", "{fixture}/initiate.json", "--workspace", "{fixture}"]],
      "command": ["{python}", "{script}", "--input", "{fixture}/complete.json", "--workspace", "{fixture}"],
      "expect": {
        "stdout_contains": ["\"action\": \"completed\"", "\"write_authorized\": false"],
        "files": [{"path": "private/improvement.json", "json": true, "contains": "\"status\": \"applied\""}]
