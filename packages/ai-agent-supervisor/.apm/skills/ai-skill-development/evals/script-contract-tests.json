    {
      "id": "learning-state-initiate",
      "script": "scripts/learning-state.py",
      "fixture": "evals/script-fixtures/learning-state",
      "covers": ["learning-state-initiate"],
      "command": ["{python}", "{script}", "--input", "{fixture}/initiate.json", "--workspace", "{fixture}"],
      "expect": {
        "stdout_contains": ["\"action\": \"initiated\"", "\"write_authorized\": false"],
        "files": [
          {"path": "private/improvement.json", "json": true, "contains": "\"status\": \"applying\""},
          {"path": "private/before/local-skills/source/SKILL.md", "contains": "Проверяй версию"}
        ]
      }
    },
    {
      "id": "learning-state-complete",
