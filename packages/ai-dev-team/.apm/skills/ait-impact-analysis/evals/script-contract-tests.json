{
  "version": 2,
  "operations": [
    {
      "id": "impact-graph-validate",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "validate"
      ],
      "inputs": []
    },
    {
      "id": "impact-graph-trace",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "trace"
      ],
      "inputs": []
    },
    {
      "id": "impact-graph-assess",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "assess"
      ],
      "inputs": []
    },
    {
      "id": "impact-graph-coverage",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "coverage"
      ],
      "inputs": []
    },
    {
      "id": "selective-verification-validate",
      "script": "scripts/selective_verification.py",
      "command_prefix": [
        "validate"
      ],
      "inputs": []
    },
    {
      "id": "selective-verification-run",
      "script": "scripts/selective_verification.py",
      "command_prefix": [
        "run"
      ],
      "inputs": []
    },
    {
      "id": "workspace-validate",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "validate",
        "--workspace"
      ],
      "inputs": [
        "workspace-impact.json",
        "contracts/.ai-dev-team/project-impact.json",
        "service/.ai-dev-team/project-impact.json"
      ]
    },
    {
      "id": "workspace-trace",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "trace",
        "--workspace"
      ],
      "inputs": [
        "workspace-impact.json",
        "contracts/.ai-dev-team/project-impact.json",
        "service/.ai-dev-team/project-impact.json"
      ]
    },
    {
      "id": "workspace-assess",
      "script": "scripts/impact_graph.py",
      "command_prefix": [
        "assess",
        "--workspace"
      ],
      "inputs": [
        "workspace-impact.json",
        "contracts/.ai-dev-team/project-impact.json",
        "service/.ai-dev-team/project-impact.json"
      ]
    }
  ],
  "cases": [
    {
      "id": "validate-minimal-impact-graph",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "command": [
        "{python}",
        "{script}",
        "validate",
        "--graph",
        "{fixture}/.ai-dev-team/project-impact.json"
      ],
      "covers": [
        "impact-graph-validate"
      ],
      "expect": {
        "stdout_contains": [
          "\"status\": \"ok\""
        ]
      }
    },
    {
      "id": "validate-acyclic-basis-impact-graph",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "prepare": [
        [
          "{python}",
          "-c",
          "import json; from pathlib import Path; path = Path('.ai-dev-team/project-impact.json'); graph = json.loads(path.read_text(encoding='utf-8')); graph['edges'][0]['basis'] = True; path.write_text(json.dumps(graph), encoding='utf-8')"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "validate",
        "--graph",
        "{fixture}/.ai-dev-team/project-impact.json"
      ],
      "covers": [
        "impact-graph-validate"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_contains": [
          "\"graph\": \"minimal-project\"",
          "\"nodes\": 2",
          "\"edges\": 1",
          "\"schema_version\": 2",
          "\"status\": \"ok\"",
          "\"semantic_model\": true",
          "\"problems\": []"
        ]
      }
    },
    {
      "id": "trace-minimal-impact-graph",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "command": [
        "{python}",
        "{script}",
        "trace",
        "--graph",
        "{fixture}/.ai-dev-team/project-impact.json",
        "--changed-path",
        "src/module.py",
        "--facet",
        "quality"
      ],
      "covers": [
        "impact-graph-trace"
      ],
      "expect": {
        "stdout_contains": [
          "\"id\": \"tests\""
        ]
      }
    },
    {
      "id": "trace-minimal-impact-graph-by-node",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "command": [
        "{python}",
        "{script}",
        "trace",
        "--graph",
        "{fixture}/.ai-dev-team/project-impact.json",
        "--changed-node",
        "implementation:quality"
      ],
      "covers": [
        "impact-graph-trace"
      ],
      "expect": {
        "stdout_contains": [
          "\"id\": \"tests\""
        ]
      }
    },
    {
      "id": "assess-minimal-impact-graph",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "command": [
        "{python}",
        "{script}",
        "assess",
        "--graph",
        "{fixture}/.ai-dev-team/project-impact.json",
        "--changed-path",
        "src/module.py",
        "--facet",
        "quality",
        "--status",
        "tests=verified_no_impact"
      ],
      "covers": [
        "impact-graph-assess"
      ],
      "expect": {
        "stdout_contains": [
          "\"complete\": true"
        ]
      }
    },
    {
      "id": "cover-minimal-impact-graph",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "command": [
        "{python}",
        "{script}",
        "coverage",
        "--graph",
        "{fixture}/.ai-dev-team/project-impact.json",
        "--repo",
        "{fixture}"
      ],
      "covers": [
        "impact-graph-coverage"
      ],
      "expect": {
        "stdout_contains": [
          "\"complete\": true"
        ]
      }
    },
    {
      "id": "validate-minimal-verification-config",
      "script": "scripts/selective_verification.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "command": [
        "{python}",
        "{script}",
        "validate",
        "--repo",
        "{fixture}",
        "--config",
        "{fixture}/.ai-dev-team/project-verification.json"
      ],
      "covers": [
        "selective-verification-validate"
      ],
      "expect": {
        "stdout_contains": [
          "\"status\": \"passed\""
        ]
      }
    },
    {
      "id": "run-minimal-verification-config",
      "script": "scripts/selective_verification.py",
      "fixture": "evals/script-fixtures/minimal-project",
      "prepare": [
        [
          "git",
          "init",
          "{fixture}"
        ],
        [
          "git",
          "-C",
          "{fixture}",
          "add",
          "."
        ],
        [
          "git",
          "-C",
          "{fixture}",
          "-c",
          "user.email=contract@example.invalid",
          "-c",
          "user.name=Contract",
          "commit",
          "-m",
          "Initial fixture"
        ],
        [
          "{python}",
          "-c",
          "from pathlib import Path; path = Path('src/module.py'); path.parent.mkdir(exist_ok=True); path.write_text('changed\\n', encoding='utf-8')"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "run",
        "--repo",
        "{fixture}",
        "--config",
        "{fixture}/.ai-dev-team/project-verification.json",
        "--base",
        "HEAD"
      ],
      "covers": [
        "selective-verification-run"
      ],
      "expect": {
        "stdout_contains": [
          "\"status\": \"passed\"",
          "\"status\": \"executed\""
        ]
      }
    },
    {
      "id": "workspace-validate-two-repositories",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/two-repositories",
      "command": [
        "{python}",
        "{script}",
        "validate",
        "--workspace",
        "{fixture}/workspace-impact.json"
      ],
      "covers": [
        "workspace-validate"
      ],
      "expect": {
        "stdout_contains": [
          "\"scope\": \"declared-repositories\"",
          "\"repositories\": [",
          "\"status\": \"ok\"",
          "\"nodes\": 6"
        ]
      }
    },
    {
      "id": "workspace-trace-two-repositories",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/two-repositories",
      "command": [
        "{python}",
        "{script}",
        "trace",
        "--workspace",
        "{fixture}/workspace-impact.json",
        "--changed-node",
        "contracts/api",
        "--facet",
        "interface"
      ],
      "covers": [
        "workspace-trace"
      ],
      "expect": {
        "stdout_contains": [
          "\"scope\": \"declared-repositories\"",
          "\"repositories\": [",
          "\"id\": \"service/implementation\"",
          "\"id\": \"service/tests\"",
          "\"repository\": \"service\""
        ]
      }
    },
    {
      "id": "workspace-assess-two-repositories",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/two-repositories",
      "command": [
        "{python}",
        "{script}",
        "assess",
        "--workspace",
        "{fixture}/workspace-impact.json",
        "--changed-node",
        "contracts/api",
        "--facet",
        "interface",
        "--status",
        "service/implementation=updated",
        "--status",
        "service/tests=verified_no_impact"
      ],
      "covers": [
        "workspace-assess"
      ],
      "expect": {
        "stdout_contains": [
          "\"scope\": \"declared-repositories\"",
          "\"repositories\": [",
          "\"id\": \"service/implementation\"",
          "\"id\": \"service/tests\"",
          "\"repository\": \"service\"",
          "\"complete\": true",
          "\"missing_statuses\": []",
          "\"blocking_statuses\": []"
        ]
      }
    },
    {
      "id": "workspace-package-source-and-installed-version",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/two-repositories",
      "command": [
        "{python}",
        "{script}",
        "trace",
        "--workspace",
        "{fixture}/workspace-impact.json",
        "--changed-node",
        "contracts/rules",
        "--facet",
        "quality"
      ],
      "covers": [
        "workspace-trace"
      ],
      "expect": {
        "stdout_contains": [
          "\"id\": \"service/installed-rules\"",
          "\"id\": \"service/implementation\"",
          "\"id\": \"service/tests\""
        ],
        "files": [
          {
            "path": "service/dependencies.json",
            "json": true,
            "contains": "\"rules_version\": \"1\""
          },
          {
            "path": "service/packages/rules.md",
            "contains": "Версия: 1."
          }
        ]
      }
    },
    {
      "id": "workspace-missing-foreign-status",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/two-repositories",
      "command": [
        "{python}",
        "{script}",
        "assess",
        "--workspace",
        "{fixture}/workspace-impact.json",
        "--changed-node",
        "contracts/api",
        "--facet",
        "interface",
        "--status",
        "service/implementation=updated"
      ],
      "covers": [
        "workspace-assess"
      ],
      "expect": {
        "exit_code": 3,
        "stdout_contains": [
          "\"complete\": false",
          "\"missing_statuses\": [",
          "\"service/tests\""
        ]
      }
    },
    {
      "id": "workspace-missing-local-graph",
      "script": "scripts/impact_graph.py",
      "fixture": "evals/script-fixtures/two-repositories",
      "prepare": [
        [
          "{python}",
          "-c",
          "from pathlib import Path; Path(\"service/.ai-dev-team/project-impact.json\").unlink()"
        ]
      ],
      "command": [
        "{python}",
        "{script}",
        "trace",
        "--workspace",
        "{fixture}/workspace-impact.json",
        "--changed-node",
        "contracts/api",
        "--facet",
        "interface"
      ],
      "covers": [
        "workspace-trace"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "graph unreadable"
        ]
      }
    }
  ]
}