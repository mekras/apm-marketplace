{
  "schema_version": 2,
  "graph": {
    "name": "example-project",
    "description": "Направления возможного влияния между частями проекта.",
    "default_facet": "semantic",
    "unmapped_paths": "block",
    "ignore": [".git/**", "local/**"]
  },
  "nodes": [
    {
      "id": "concept",
      "title": "Концепция проекта",
      "kind": "concept",
      "semantic_type": "концепция проекта",
      "authority": "canonical",
      "paths": ["docs/concept.md"],
      "checks": ["ait-docs-concept"]
    },
    {
      "id": "requirements",
      "title": "Требования",
      "kind": "requirements",
      "semantic_type": "требования продукта",
      "authority": "canonical",
      "paths": ["docs/requirements.md", "docs/requirements/**"],
      "checks": ["ait-req-management", "ait-req-validation"]
    }
  ],
  "edges": [
    {
      "from": "concept",
      "to": "requirements",
      "relation": "constrains",
      "facets": ["semantic", "structure"],
      "rationale": "Требования раскрывают замысел и не должны противоречить ему."
    }
  ]
}
